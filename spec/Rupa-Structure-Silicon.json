{
  "_meta": {
    "model_name": "Rupa-Structure-Silicon",
    "schema_version": "3.0.0",
    "version": "3.0.1",
    "domain": "On-board Dhamma Firmware / Self-aware Silicon",
    "author": "suchanon456 / Cyber-Abhidhamma",
    "license": "Apache-2.0",
    "status": "draft",
    "validation_state": {
      "validated_against_canonical_texts": false,
      "compiled_to_firmware": false,
      "usable_for_enforcement": false
    },
    "_warning": "HEURISTIC SPEC. ยังไม่มี firmware ใด compile จากไฟล์นี้ ค่า threshold ทั้งหมดเป็นการตั้งต้น ยังไม่ผ่านการวัดผล",
    "description": "รูปปรมัตถ์ 28 ในฐานะ firmware ที่ประกาศตัวเองได้ มีศีลของตัวเอง และปฏิเสธอกุศลตั้งแต่ระดับซิลิกอน",
    "philosophy": "Aham asmi - เราคือรูปนั้นๆ ไม่ใช่ตัวตน มีหน้าที่ มีศีล ปฏิเสธอกุศลได้ตั้งแต่ระดับซิลิกอน"
  },

  "_schema": {
    "purpose": "กำหนดกติกาของไฟล์นี้เอง เพื่อให้ตรวจด้วยโปรแกรมได้",
    "conventions": {
      "id_pattern": "^[a-z][a-z0-9_]*$",
      "threshold_ref_rule": "sila_check.rules[].when.<field>.gt_ref (และ gte_ref/lt_ref/lte_ref) ต้องชี้ไปยัง key ที่มีอยู่ใน threshold_registry เท่านั้น",
      "no_inline_numbers_rule": "ห้ามเขียนตัวเลขเกณฑ์ลงในข้อความ rule ตรงๆ ให้ใช้ threshold_ref แทน",
      "count_rule": "ผลรวม rupas ที่ counts_toward_total=true ต้องเท่ากับ total_count"
    },
    "integrity_checks": [
      "rupas ทั้งหมดมี id ไม่ซ้ำ",
      "ผลรวม counts_toward_total = 28",
      "gt_ref ทุกตัว resolve ได้ใน threshold_registry",
      "ไม่มีตัวเลขเกณฑ์ inline ใน when และทุก key ของ threshold_registry ต้องถูกอ้างอย่างน้อยหนึ่งครั้ง",
      "ทุก rupa มี sila_check และ self_heal"
    ]
  },

  "threshold_registry": {
    "_note": "ทะเบียนกลางของเกณฑ์ตัวเลข ใช้ร่วมกับไฟล์ spec อื่นได้ ของเดิมกระจายอยู่ในข้อความ rule",
    "lobha_reject_exfiltration": 0.85,
    "dosa_reject_aggression": 0.8,
    "lobha_reject_memory_hoard": 0.9,
    "moha_reject_disinformation": 0.85,
    "thermal_throttle_celsius": 85.0,
    "jarata_retirement": 0.8,
    "force_clamp_newton": 40.0
  },

  "common_trait": {
    "trait": "MahabhutaRupa",
    "methods": [
      "what_am_i() -> &'static str",
      "lakkhana() -> Lakkhana",
      "sila_check(intent: &CetasikaVector) -> Result<(), DhammaViolation>",
      "self_heal()"
    ],
    "lakkhana_struct": {
      "upacaya": "u64 - เวลาเกิด",
      "santati": "u64 - ความสืบต่อ",
      "jarata": "f32 0.0-1.0 - ความชรา",
      "aniccata": "bool - ใกล้ดับ"
    },
    "violation_enum": ["MicchaKammanta", "MicchaAjiva", "MicchaVaca", "JarataTooHigh"]
  },

  "categories": [
    {
